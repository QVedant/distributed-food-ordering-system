# Deployment configuration
DEPLOYMENT_MODE=team

# ZeroTier IP addresses
VM1_ZT_IP=192.168.195.166
VM2_ZT_IP=192.168.195.21
VM3_ZT_IP=192.168.195.167
VM4_ZT_IP=192.168.195.127

# Kafka connection
KAFKA_PORT=9092
BS=192.168.195.21:9092,192.168.195.167:9092

# Kafka topics and cluster settings
ORDERS_TOPIC=orders
METRICS_TOPIC=order_metrics
KAFKA_PARTITIONS=2
KAFKA_REPLICATION_FACTOR=2
KAFKA_ACKS=all

# Kafka consumer settings
KAFKA_GROUP_ID=vm1-metrics-consumer
KAFKA_AUTO_OFFSET_RESET=earliest

# Input dataset
ORDERS_INPUT_FILE=order.jsonl

# Local landing files
ORDERS_LANDED_FILE=data/landed/orders_landed.jsonl
METRICS_LANDED_FILE=data/landed/order_metrics_landed.jsonl

# Processed data
METRICS_PROCESSED_FILE=data/processed/order_metrics.jsonl

# Analytics output files
RESTAURANT_OUTPUT_FILE=restaurant_summary.csv
CITY_OUTPUT_FILE=city_summary.csv

# Spark configuration
SPARK_MASTER=local[*]
