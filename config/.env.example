# ============================================================
# Distributed Food Ordering System - Team Configuration
# Copy this template to the project root as .env
# Replace CHANGE_ME values tomorrow when the team is available.
# ============================================================

# Deployment profile: local or team
DEPLOYMENT_MODE=local

# -------------------- ZeroTier VM addresses -----------------
# Enter the assigned ZeroTier IPv4 addresses tomorrow.
VM1_ZT_IP=CHANGE_ME
VM2_ZT_IP=CHANGE_ME
VM3_ZT_IP=CHANGE_ME
VM4_ZT_IP=CHANGE_ME

# -------------------- Kafka connection ----------------------
KAFKA_PORT=9092
BS=localhost:9092

# Kafka topics
ORDERS_TOPIC=orders
METRICS_TOPIC=order_metrics

# Required final team-cluster topic configuration
KAFKA_PARTITIONS=2
KAFKA_REPLICATION_FACTOR=2
KAFKA_ACKS=all

# Consumer configuration
KAFKA_GROUP_ID=vm1-metrics-consumer
KAFKA_AUTO_OFFSET_RESET=earliest

# -------------------- Local project paths ------------------
ORDERS_INPUT_FILE=order.jsonl
ORDERS_LANDED_FILE=data/landed/orders_landed.jsonl
METRICS_LANDED_FILE=data/landed/order_metrics_landed.jsonl
METRICS_PROCESSED_FILE=data/processed/order_metrics.jsonl

RESTAURANT_OUTPUT_FILE=restaurant_summary.csv
CITY_OUTPUT_FILE=city_summary.csv

# -------------------- Spark configuration -------------------
SPARK_MASTER=local[*]
